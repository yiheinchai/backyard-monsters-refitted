diff --git a/core/src/frame_interpolation.rs b/core/src/frame_interpolation.rs
new file mode 100644
index 00000000..fa88c1e0
--- /dev/null
+++ b/core/src/frame_interpolation.rs
@@ -0,0 +1,145 @@
+//! Render-time interpolation between frames.
+//!
+//! Content runs at its own frame rate (often 24-40 fps), but displays refresh at 60-120 Hz.
+//! When interpolation is enabled, every display object remembers the matrix it had at the end
+//! of the previous frame and is drawn part-way between that and its current matrix, according
+//! to how far the player has got through the current frame. Frames, scripts, timers and
+//! timelines still run exactly as often as before; only presentation is smoothed, at the cost
+//! of showing the stage up to one frame behind.
+//!
+//! Only objects that were drawn on screen during the previous frame are interpolated, so
+//! objects that were just created, shown, or moved in from an off-stage pool snap into place
+//! instead of sliding there. Large jumps (teleports) also snap.
+
+use ruffle_render::matrix::Matrix;
+use std::sync::atomic::{AtomicBool, AtomicU32, Ordering};
+use swf::Twips;
+
+/// Serial number of the frame currently being run. Zero means "never".
+static FRAME: AtomicU32 = AtomicU32::new(1);
+
+/// Interpolation factor (as `f32` bits) used by the render in progress, or `DISABLED`.
+static ALPHA: AtomicU32 = AtomicU32::new(DISABLED);
+
+/// Set when the render in progress drew at least one object between two positions.
+static IN_MOTION: AtomicBool = AtomicBool::new(false);
+
+const DISABLED: u32 = u32::MAX;
+
+/// Moves longer than this per frame are teleports and are not interpolated (160px).
+const MAX_STEP: i32 = 160 * Twips::TWIPS_PER_PIXEL;
+
+/// Changes to scale/rotation/skew larger than this are snapped (e.g. a sprite flipping
+/// around by setting scaleX to -1 should not visibly squash through zero).
+const MAX_LINEAR_STEP: f32 = 0.35;
+
+/// The serial number of the frame currently being run.
+pub fn current_frame() -> u32 {
+    FRAME.load(Ordering::Relaxed)
+}
+
+/// Called at the start of every frame.
+pub fn advance_frame() {
+    let next = FRAME.load(Ordering::Relaxed).wrapping_add(1).max(1);
+    FRAME.store(next, Ordering::Relaxed);
+}
+
+/// Starts a render that interpolates by `alpha` (0 = previous frame, 1 = current frame),
+/// or a normal render when `alpha` is `None`.
+pub fn begin_render(alpha: Option<f32>) {
+    IN_MOTION.store(false, Ordering::Relaxed);
+    let bits = alpha.map_or(DISABLED, |alpha| alpha.clamp(0.0, 1.0).to_bits());
+    ALPHA.store(bits, Ordering::Relaxed);
+}
+
+/// Ends the render started by `begin_render`.
+/// Returns whether anything was drawn in motion, i.e. whether rendering again before the next
+/// frame would show something different.
+pub fn end_render() -> bool {
+    ALPHA.store(DISABLED, Ordering::Relaxed);
+    IN_MOTION.load(Ordering::Relaxed)
+}
+
+/// The interpolation factor of the render in progress, if interpolation is enabled.
+pub fn alpha() -> Option<f32> {
+    let bits = ALPHA.load(Ordering::Relaxed);
+    (bits != DISABLED).then(|| f32::from_bits(bits))
+}
+
+/// The matrix to draw an object with, part-way from `prev` to `cur`.
+pub fn interpolate(prev: &Matrix, cur: &Matrix, alpha: f32) -> Matrix {
+    if prev == cur {
+        return *cur;
+    }
+
+    let dx = cur.tx.get() - prev.tx.get();
+    let dy = cur.ty.get() - prev.ty.get();
+    if dx.abs() > MAX_STEP || dy.abs() > MAX_STEP {
+        return *cur;
+    }
+
+    IN_MOTION.store(true, Ordering::Relaxed);
+
+    let lerp = |from: f32, to: f32| from + (to - from) * alpha;
+    let linear_step = (cur.a - prev.a).abs()
+        + (cur.b - prev.b).abs()
+        + (cur.c - prev.c).abs()
+        + (cur.d - prev.d).abs();
+    let (a, b, c, d) = if linear_step <= MAX_LINEAR_STEP {
+        (
+            lerp(prev.a, cur.a),
+            lerp(prev.b, cur.b),
+            lerp(prev.c, cur.c),
+            lerp(prev.d, cur.d),
+        )
+    } else {
+        (cur.a, cur.b, cur.c, cur.d)
+    };
+
+    Matrix {
+        a,
+        b,
+        c,
+        d,
+        tx: Twips::new(prev.tx.get() + (dx as f32 * alpha).round() as i32),
+        ty: Twips::new(prev.ty.get() + (dy as f32 * alpha).round() as i32),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn translate(x: i32, y: i32) -> Matrix {
+        Matrix {
+            tx: Twips::new(x),
+            ty: Twips::new(y),
+            ..Matrix::IDENTITY
+        }
+    }
+
+    #[test]
+    fn interpolates_translation() {
+        let m = interpolate(&translate(0, 0), &translate(200, -100), 0.25);
+        assert_eq!(m.tx.get(), 50);
+        assert_eq!(m.ty.get(), -25);
+    }
+
+    #[test]
+    fn snaps_teleports() {
+        let cur = translate(MAX_STEP + 1, 0);
+        assert_eq!(interpolate(&translate(0, 0), &cur, 0.5), cur);
+    }
+
+    #[test]
