new file mode 100644
index 00000000..56ad0e2a
--- /dev/null
+++ b/core/src/auto_cache.rs
@@ -0,0 +1,151 @@
+//! Automatic layer caching.
+//!
+//! Interfaces built in Flash are usually deep trees of shapes, text and bitmaps that rarely
+//! change, but every one of them costs at least one draw call on every frame. When enabled, the
+//! player watches how often each container changes and draws the ones that have stayed still
+//! for a while through a bitmap cache (the same machinery as `cacheAsBitmap`), so a whole panel
+//! costs a single draw until something in it changes.
+//!
+//! Containers that keep changing while cached are dropped from the cache again, and wait longer
+//! before being tried again; their stable children are then cached individually instead.
+//! Containers that would render differently through a cache (blend modes inside, editable text
+//! with a blinking caret, video) or would need a very large texture are never cached.
+
+use std::sync::atomic::{AtomicBool, Ordering};
+
+static ENABLED: AtomicBool = AtomicBool::new(false);
+
+/// Unchanged renders needed before a container is cached (doubled per penalty step).
+const STABLE_RENDERS: u16 = 30;
+
+/// Changes allowed while cached before the cache is dropped.
+const MAX_CHURN: u8 = 3;
+
+/// Longest back-off, as a power of two of `STABLE_RENDERS`.
+const MAX_PENALTY: u8 = 5;
+
+/// Cached containers are re-rendered this often even if nothing reported a change,
+/// so that a change Ruffle fails to notice can never leave a stale image for long.
+const REFRESH_RENDERS: u16 = 240;
+
+/// Descendants needed for a container to be worth caching.
+const MIN_DESCENDANTS: u32 = 3;
+
+/// Descendants beyond which the eligibility scan gives up.
+const MAX_DESCENDANTS: u32 = 4000;
+
+/// Largest cache texture side, in device pixels.
+const MAX_SIDE: f64 = 2048.0;
+
+pub fn set_enabled(enabled: bool) {
+    ENABLED.store(enabled, Ordering::Relaxed);
+}
+
+pub fn enabled() -> bool {
+    ENABLED.load(Ordering::Relaxed)
+}
+
+/// Per-object bookkeeping.
+#[derive(Clone, Copy, Default, Debug)]
+pub struct AutoCacheState {
+    /// Consecutive renders without a change.
+    pub stable: u16,
+    /// Changes seen since the object was last cached.
+    pub churn: u8,
+    /// Back-off level, raised each time a cache is dropped for churning.
+    pub penalty: u8,
+}
+
+/// What to do with an object's automatic cache after one render.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Decision {
+    Keep,
+    Enable,
+    Disable,
+    Refresh,
+}
+
+impl AutoCacheState {
+    /// Updates the bookkeeping for one render and decides what to do with the cache.
+    /// `changed` is whether the object or anything inside it changed since the last render.
+    pub fn step(&mut self, changed: bool, cached: bool) -> Decision {
+        if changed {
+            self.stable = 0;
+            if cached {
+                self.churn += 1;
+                if self.churn >= MAX_CHURN {
+                    self.churn = 0;
+                    self.penalty = (self.penalty + 1).min(MAX_PENALTY);
+                    return Decision::Disable;
+                }
+            }
+            return Decision::Keep;
+        }
+
+        self.stable = self.stable.saturating_add(1);
+        if cached {
+            if self.stable == STABLE_RENDERS {
+                // Settled again; forgive earlier changes.
+                self.churn = 0;
+            }
+            if self.stable.is_multiple_of(REFRESH_RENDERS) {
+                return Decision::Refresh;
+            }
+            Decision::Keep
+        } else if self.stable == STABLE_RENDERS << self.penalty {
+            Decision::Enable
+        } else {
+            Decision::Keep
+        }
+    }
+}
+
+/// Whether a cache of this size (in device pixels) is acceptable.
+pub fn size_ok(width: f64, height: f64) -> bool {
+    width >= 1.0 && height >= 1.0 && width <= MAX_SIDE && height <= MAX_SIDE
+}
+
+pub fn descendants_ok(count: u32) -> bool {
+    (MIN_DESCENDANTS..=MAX_DESCENDANTS).contains(&count)
+}
+
+pub const SCAN_LIMIT: u32 = MAX_DESCENDANTS + 1;
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn caches_after_stable_period() {
+        let mut state = AutoCacheState::default();
+        for _ in 1..STABLE_RENDERS {
+            assert_eq!(state.step(false, false), Decision::Keep);
+        }
+        assert_eq!(state.step(false, false), Decision::Enable);
+    }
+
+    #[test]
+    fn drops_churning_cache_and_backs_off() {
+        let mut state = AutoCacheState::default();
+        assert_eq!(state.step(true, true), Decision::Keep);
+        assert_eq!(state.step(true, true), Decision::Keep);
+        assert_eq!(state.step(true, true), Decision::Disable);
+        assert_eq!(state.penalty, 1);
+        for _ in 1..(STABLE_RENDERS * 2) {
+            assert_eq!(state.step(false, false), Decision::Keep);
+        }
+        assert_eq!(state.step(false, false), Decision::Enable);
+    }
+
+    #[test]
+    fn refreshes_periodically() {
+        let mut state = AutoCacheState::default();
+        let mut refreshes = 0;
+        for _ in 0..REFRESH_RENDERS {
+            if state.step(false, true) == Decision::Refresh {
+                refreshes += 1;
+            }
+        }
+        assert_eq!(refreshes, 1);
+    }
+}
