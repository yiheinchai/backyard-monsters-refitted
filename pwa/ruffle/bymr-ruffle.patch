+/// A stream that plays samples that are already decoded and at the output sample rate.
+struct DecodedStream {
+    frames: Arc<[[i16; 2]]>,
+    position: usize,
+    source_sample_rate: u16,
+    output_sample_rate: u32,
+}
+
+impl Stream for DecodedStream {
+    #[inline]
+    fn source_position(&self) -> u32 {
+        (self.position as u64 * u64::from(self.source_sample_rate)
+            / u64::from(self.output_sample_rate.max(1))) as u32
+    }
+
+    #[inline]
+    fn source_sample_rate(&self) -> u16 {
+        self.source_sample_rate
+    }
+}
+
+impl dasp::signal::Signal for DecodedStream {
+    type Frame = [i16; 2];
+
+    #[inline]
+    fn next(&mut self) -> [i16; 2] {
+        match self.frames.get(self.position) {
+            Some(frame) => {
+                self.position += 1;
+                *frame
+            }
+            None => Default::default(),
+        }
+    }
+
+    #[inline]
+    fn is_exhausted(&self) -> bool {
+        self.position >= self.frames.len()
+    }
+}
