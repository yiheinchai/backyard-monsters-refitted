+/// Draws `source` onto an opaque `dest` with the add or subtract blend mode, matching the
+/// GPU renderers: the color-transformed, premultiplied source is added to (or subtracted from)
+/// the destination and clamped. The destination stays opaque.
+fn add_or_subtract_on_cpu<'gc>(
+    context: &mut UpdateContext<'gc>,
+    source: BitmapData<'gc>,
+    dest: BitmapData<'gc>,
+    source_region: PixelRegion,
+    dest_region: PixelRegion,
+    transform: &ColorTransform,
+    subtract: bool,
+) {
+    // Read the source first, as it may be the destination itself.
+    let source_pixels: Vec<Color> = {
+        let source = source.read_area(source_region, context.renderer);
+        let mut pixels =
+            Vec::with_capacity((source_region.width() * source_region.height()) as usize);
+        for y in 0..source_region.height() {
+            for x in 0..source_region.width() {
+                let color =
+                    source.get_pixel32_raw(source_region.x_min + x, source_region.y_min + y);
+                pixels.push(
+                    Color::from(transform * swf::Color::from(color.to_un_multiplied_alpha()))
+                        .to_premultiplied_alpha(true),
+                );
+            }
+        }
+        pixels
+    };
+
+    let mut dest = dest.sync(context.renderer).borrow_mut(context.gc());
+    let combine = |d: u8, s: u8| -> u8 {
+        if subtract {
+            d.saturating_sub(s)
+        } else {
+            d.saturating_add(s)
+        }
+    };
+    for y in 0..dest_region.height() {
+        for x in 0..dest_region.width() {
+            let s = source_pixels[(y * source_region.width() + x) as usize];
+            let d = dest.get_pixel32_raw(dest_region.x_min + x, dest_region.y_min + y);
+            let color = Color::rgba(
+                combine(d.red(), s.red()),
+                combine(d.green(), s.green()),
+                combine(d.blue(), s.blue()),
+                255,
+            );
+            dest.set_pixel32_raw(dest_region.x_min + x, dest_region.y_min + y, color);
+        }
+    }
+    dest.set_cpu_dirty(context.gc(), dest_region);
+}
+
+/// Applies color matrix and convolution filters on the CPU when both bitmaps are already
+/// there. Pixel effects commonly mix filters with CPU reads such as `getPixel` every frame;
+/// running the filter on the GPU would force a readback each time.
+/// Returns false if the filter isn't handled here.
+fn apply_filter_on_cpu<'gc>(
+    context: &mut UpdateContext<'gc>,
+    target: BitmapData<'gc>,
+    source: BitmapData<'gc>,
+    source_point: (u32, u32),
+    source_size: (u32, u32),
+    dest_point: (i32, i32),
+    filter: &Filter,
+) -> bool {
+    if !matches!(
+        filter,
+        Filter::ColorMatrixFilter(_) | Filter::ConvolutionFilter(_)
+    ) {
+        return false;
+    }
+    let whole_source = PixelRegion::for_whole_size(source.width(), source.height());
+    let whole_target = PixelRegion::for_whole_size(target.width(), target.height());
+    if !source.can_read(whole_source) || !target.can_read(whole_target) {
+        return false;
+    }
+
+    let mut source_region = whole_source;
+    let mut dest_region = whole_target;
+    dest_region.clamp_with_intersection(
+        dest_point,
+        (source_point.0 as i32, source_point.1 as i32),
+        (source_size.0 as i32, source_size.1 as i32),
+        &mut source_region,
+    );
+    if dest_region.width() == 0 || dest_region.height() == 0 {
+        return true;
+    }
+
+    // Snapshot the source (premultiplied), as it may also be the target.
+    let (width, height) = (source.width() as i32, source.height() as i32);
+    let pixels: Vec<Color> = {
+        let source = source.read_area(whole_source, context.renderer);
+        let mut pixels = Vec::with_capacity((width * height) as usize);
+        for y in 0..height {
+            for x in 0..width {
+                pixels.push(source.get_pixel32_raw(x as u32, y as u32));
+            }
+        }
+        pixels
+    };
+    let source_transparent = source.transparency();
+    let transparent = target.transparency();
+    let pixel = |x: i32, y: i32| pixels[(y * width + x) as usize];
+
+    let mut dest = target.sync(context.renderer).borrow_mut(context.gc());
+    for y in 0..dest_region.height() {
+        for x in 0..dest_region.width() {
+            let sx = (source_region.x_min + x) as i32;
+            let sy = (source_region.y_min + y) as i32;
+            let color = match filter {
+                Filter::ColorMatrixFilter(filter) => {
+                    let s = pixel(sx, sy).to_un_multiplied_alpha();
+                    let (r, g, b, a) = (
+                        f32::from(s.red()),
+                        f32::from(s.green()),
+                        f32::from(s.blue()),
+                        f32::from(s.alpha()),
+                    );
+                    let m = &filter.matrix;
+                    let row = |i: usize| {
+                        (m[i] * r + m[i + 1] * g + m[i + 2] * b + m[i + 3] * a + m[i + 4])
+                            .round()
+                            .clamp(0.0, 255.0) as u8
+                    };
+                    Color::rgba(row(0), row(5), row(10), row(15))
+                        .to_premultiplied_alpha(transparent)
+                }
+                Filter::ConvolutionFilter(filter) => {
+                    let cols = i32::from(filter.num_matrix_cols);
+                    let rows = i32::from(filter.num_matrix_rows);
+                    let preserve_alpha = filter.is_preserve_alpha();
+                    let default = Color::rgba(
+                        filter.default_color.r,
+                        filter.default_color.g,
+                        filter.default_color.b,
+                        filter.default_color.a,
+                    );
+                    let mut sum = [0.0f32; 4];
+                    for row in 0..rows {
+                        for col in 0..cols {
+                            let weight = filter
+                                .matrix
+                                .get((row * cols + col) as usize)
+                                .copied()
+                                .unwrap_or(0.0);
+                            if weight == 0.0 {
+                                continue;
+                            }
+                            let nx = sx + col - cols / 2;
+                            let ny = sy + row - rows / 2;
+                            let sample = if nx >= 0 && ny >= 0 && nx < width && ny < height {
+                                pixel(nx, ny)
+                            } else if filter.is_clamped() {
+                                pixel(nx.clamp(0, width - 1), ny.clamp(0, height - 1))
+                            } else {
+                                default.to_premultiplied_alpha(source_transparent)
+                            };
+                            // Convolve straight colors when keeping alpha, premultiplied otherwise.
+                            let sample = if preserve_alpha {
+                                sample.to_un_multiplied_alpha()
+                            } else {
+                                sample
+                            };
+                            sum[0] += f32::from(sample.red()) * weight;
+                            sum[1] += f32::from(sample.green()) * weight;
+                            sum[2] += f32::from(sample.blue()) * weight;
+                            sum[3] += f32::from(sample.alpha()) * weight;
+                        }
+                    }
+                    let divisor = if filter.divisor == 0.0 {
+                        1.0
+                    } else {
+                        filter.divisor
+                    };
+                    let channel =
+                        |v: f32| (v / divisor + filter.bias).round().clamp(0.0, 255.0) as u8;
+                    if preserve_alpha {
+                        let alpha = pixel(sx, sy).alpha();
+                        Color::rgba(channel(sum[0]), channel(sum[1]), channel(sum[2]), alpha)
+                            .to_premultiplied_alpha(transparent)
+                    } else {
+                        let a = if transparent { channel(sum[3]) } else { 255 };
+                        Color::rgba(
+                            channel(sum[0]).min(a),
+                            channel(sum[1]).min(a),
+                            channel(sum[2]).min(a),
+                            a,
+                        )
+                    }
+                }
