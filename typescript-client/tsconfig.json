{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "openfl/*": ["node_modules/openfl/lib/openfl/*"],
      "gs/*": ["scripts/gs/*"]
    }
  },
  "include": ["scripts/**/*"],
  "exclude": ["node_modules", "scripts/tools/**/*"]
}
