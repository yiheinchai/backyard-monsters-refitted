+    /// Returns a stream playing a short sound from its decoded samples, decoding and resampling
+    /// the sound the first time. Returns `None` for long sounds or if decoding fails, which the
+    /// caller then decodes as it plays.
+    fn cached_stream(&mut self, sound_handle: SoundHandle) -> Option<Box<dyn Stream>> {
+        let sound = &self.sounds[sound_handle];
+        if !sound.decode_tried {
+            let decoded = self.decode_sound(sound);
+            let sound = &mut self.sounds[sound_handle];
+            sound.decode_tried = true;
+            sound.decoded = decoded;
+        }
+        let sound = &self.sounds[sound_handle];
+        Some(Box::new(DecodedStream {
+            frames: Arc::clone(sound.decoded.as_ref()?),
+            position: 0,
+            source_sample_rate: sound.format.sample_rate,
+            output_sample_rate: self.output_sample_rate,
+        }))
+    }
+
+    /// Decodes a short sound and resamples it to the output sample rate, producing exactly the
+    /// frames a stream from `make_stream_from_simple_event_sound` would.
+    fn decode_sound(&self, sound: &Sound) -> Option<Arc<[[i16; 2]]>> {
+        use dasp::signal::Signal;
+
+        let source_rate = u32::from(sound.format.sample_rate).max(1);
+        if sound.num_sample_frames > MAX_DECODED_SECONDS * source_rate {
+            return None;
+        }
+        let max_frames = (MAX_DECODED_SECONDS * self.output_sample_rate) as usize;
+        let data = Cursor::new(ArcAsRef(Arc::clone(&sound.data)));
+        let decoder = decoders::make_decoder(&sound.format, data).ok()?;
+        let mut stream = self.make_resampler(DecoderStream::new(decoder));
+        let mut frames = Vec::with_capacity(
+            (u64::from(sound.num_sample_frames) * u64::from(self.output_sample_rate)
+                / u64::from(source_rate)) as usize
+                + 1,
+        );
+        while !stream.is_exhausted() {
+            if frames.len() >= max_frames {
+                return None;
+            }
+            frames.push(stream.next());
+        }
+        Some(frames.into())
+    }
+
