+/// Updates a container's automatic layer cache after it was (or was not) changed since the
+/// last render. See `crate::auto_cache`.
+fn update_auto_cache<'gc>(
+    this: DisplayObject<'gc>,
+    changed: bool,
+    context: &mut RenderContext<'_, 'gc>,
+) {
+    let base = this.base();
+    let auto = base.contains_flag(DisplayObjectFlags::AUTO_CACHE_AS_BITMAP);
+    if !auto && this.is_bitmap_cached() {
+        // Cached for its own reasons (cacheAsBitmap, filters); leave it alone.
+        return;
+    }
+    if !base.visible() {
+        return;
+    }
+
+    let mut state = base.auto_cache.get();
+    let decision = state.step(changed, auto);
+    base.auto_cache.set(state);
+
+    match decision {
+        Decision::Keep => {}
+        Decision::Enable => {
+            if auto_cache_eligible(this, context) {
+                base.set_auto_bitmap_cache(true);
+            }
+        }
+        Decision::Disable => base.set_auto_bitmap_cache(false),
+        Decision::Refresh => {
+            if let Some(cache) = &mut *base.bitmap_cache_mut() {
+                cache.make_dirty();
+            }
+        }
+    }
+}
+
+/// Whether drawing `this` through a bitmap cache would look the same and be worth it.
+fn auto_cache_eligible<'gc>(this: DisplayObject<'gc>, context: &RenderContext<'_, 'gc>) -> bool {
+    if this.maskee().is_some() || this.blend_mode() != ExtendedBlendMode::Normal {
+        return false;
+    }
+
+    let bounds = this.world_bounds(BoundsMode::Engine);
+    if !bounds.intersects(&context.stage.view_bounds()) {
+        return false;
+    }
+    let view = context.stage.view_matrix();
+    let width = bounds.width().to_pixels() * f64::from(view.a.abs());
+    let height = bounds.height().to_pixels() * f64::from(view.d.abs());
+    if !auto_cache::size_ok(width, height) {
+        return false;
+    }
+
+    let mut descendants = 0;
+    auto_cache_scan(this, &mut descendants) && auto_cache::descendants_ok(descendants)
+}
+
+/// Rejects subtrees that would render differently, or go stale, inside a bitmap cache.
+fn auto_cache_scan(this: DisplayObject<'_>, descendants: &mut u32) -> bool {
+    let Some(container) = this.as_container() else {
+        return true;
+    };
+    for child in container.iter_render_list() {
+        *descendants += 1;
+        if *descendants >= auto_cache::SCAN_LIMIT {
+            return false;
+        }
+        if child.blend_mode() != ExtendedBlendMode::Normal || matches!(child, DisplayObject::Video(_)) {
+            return false;
+        }
+        if let Some(text) = child.as_edit_text()
+            && text.is_editable()
+        {
+            return false;
+        }
+        if !auto_cache_scan(child, descendants) {
+            return false;
+        }
+    }
+    true
+}
