+    fn play_all(mut stream: Box<dyn Stream>) -> Vec<[i16; 2]> {
+        let mut frames = vec![];
+        while !stream.is_exhausted() {
+            frames.push(stream.next());
+        }
+        frames
+    }
+
+    #[test]
+    fn decoded_sound_plays_like_the_decoder() {
+        let mut mixer = AudioMixer::new(2, 44100);
+        let handle = register(&mut mixer, 5000, 22050);
+        let sound = &mixer.sounds[handle];
+        let data = Cursor::new(ArcAsRef(Arc::clone(&sound.data)));
+        let expected = play_all(
+            mixer
+                .make_stream_from_simple_event_sound(&sound.format, data)
+                .unwrap(),
+        );
+        assert!(expected.len() > 9000);
+
+        let stream = mixer
+            .cached_stream(handle)
+            .expect("short sounds are kept decoded");
+        assert_eq!(stream.source_sample_rate(), 22050);
+        assert_eq!(play_all(stream), expected);
+        // Later plays reuse the samples.
+        let decoded = mixer.sounds[handle].decoded.clone().unwrap();
+        mixer.cached_stream(handle).unwrap();
+        assert!(Arc::ptr_eq(
+            &decoded,
+            mixer.sounds[handle].decoded.as_ref().unwrap()
+        ));
+    }
+
+    #[test]
+    fn long_sounds_are_not_kept_decoded() {
+        let mut mixer = AudioMixer::new(2, 44100);
