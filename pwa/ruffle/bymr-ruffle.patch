+thread_local! {
+    static FRAME_EPOCH: std::cell::Cell<u64> = const { std::cell::Cell::new(1) };
+}
+
+/// Records a change that frame construction or frame scripts may have to act on: a clip
+/// changing frame or queueing a frame script, or a display object joining a container or the
+/// orphan list. Gotos skip the whole-stage frame pass when nothing has been recorded since the
+/// last one.
+///
+/// The counter is shared by all players on the thread, which only makes them do extra passes.
+pub fn bump_frame_epoch() {
+    FRAME_EPOCH.with(|epoch| epoch.set(epoch.get() + 1));
+}
+
+fn frame_epoch() -> u64 {
+    FRAME_EPOCH.with(|epoch| epoch.get())
+}
+
+thread_local! {
+    static FRAME_PASS_DEPTH: std::cell::Cell<u32> = const { std::cell::Cell::new(0) };
+}
+
+/// Marks a frame construction and frame script pass over the whole stage as running, until
+/// dropped.
+struct FramePass;
+
+impl FramePass {
+    fn start(context: &mut UpdateContext<'_>) -> Self {
+        FRAME_PASS_DEPTH.with(|depth| {
+            if depth.get() == 0 {
+                *context.frame_pass_epoch = frame_epoch();
+            }
+            depth.set(depth.get() + 1);
+        });
+        Self
+    }
+
+    fn running() -> bool {
+        FRAME_PASS_DEPTH.with(|depth| depth.get() > 0)
+    }
+}
+
+impl Drop for FramePass {
+    fn drop(&mut self) {
+        FRAME_PASS_DEPTH.with(|depth| depth.set(depth.get() - 1));
+    }
+}
